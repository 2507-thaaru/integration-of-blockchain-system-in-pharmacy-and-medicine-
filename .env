# ── SERVER ─────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── DATABASE ────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/pharmachain

# ── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string_256bits
JWT_EXPIRES_IN=8h

# ── BLOCKCHAIN ──────────────────────────────────────────────────
# Step 1: paste your Hardhat / Sepolia / Mainnet RPC URL here
RPC_URL=http://127.0.0.1:8545

# Step 2: paste the private key of your DEPLOYER wallet (from Hardhat or MetaMask export)
# ⚠️  NEVER commit the real key — add .env to .gitignore
PRIVATE_KEY=0xdf57089febbacf7ba0bc227dafbffa9fc08a93fdc68e1e42411a14efcf23656e

# Step 3: paste your deployed contract address (after running: npx hardhat run scripts/deploy.js)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Chain ID — 31337 = Hardhat local | 11155111 = Sepolia testnet | 1 = Mainnet
CHAIN_ID=31337

# ── CORS ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
